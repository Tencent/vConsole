{
  "compilerOptions": {
    "emitDeclarationOnly": true,
    "declaration": true,
    // "declarationDir": "./dist/typings",
    "outFile": "dist/vconsole.min.d.ts",
    "outDir": "./dist",
    "baseUrl": "./src",
    "rootDir": "./src",
    "moduleResolution": "node",
    "allowJs": true,
    "target": "es2018",
    // "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules"]
}
